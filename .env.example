DISCORD_TOKEN=你的Discord_Bot_Token
# API 查詢失敗時的備用文字
DEATH_LINK_REPLY=無法取得死亡資訊
# 新伺服器預設裝備語言：en / zh-TW / zh-CN
ITEM_LOCALE=zh-TW
# Google Sheet（/createparty）
GOOGLE_SHEET_ID=你的Google試算表ID
# Google Sheet（Regear 申請與名稱綁定）
GOOGLE_SHEET_ID_REGEAR=你的Regear試算表ID
# Regear 同時處理上限（超出回覆稍後再試）
REGEAR_MAX_CONCURRENT=2
# 行程記憶體超過此值（MB）時拒絕新申請（預留低於 256MB）
REGEAR_MAX_RSS_MB=220
# 將 Service Account JSON 金鑰整份貼成單行
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# 範本工作表名稱（不存在時自動複製建立）
SHEET_TEMPLATE_NAME=範本
