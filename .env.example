DISCORD_TOKEN=你的Discord_Bot_Token
GOOGLE_SHEET_ID=你的Google試算表ID
GOOGLE_CREDENTIALS=credentials.json

# 可取消他人報名的 Discord 使用者 ID（逗號分隔）
CANCEL_MANAGER_USER_IDS=123456789012345678,987654321098765432
# 可取消他人報名的 Discord 身分組 ID（逗號分隔）
CANCEL_MANAGER_ROLE_IDS=111111111111111111
# 設為 true 時，擁有「管理訊息」權限的成員也可取消他人報名
CANCEL_ALLOW_MANAGE_MESSAGES=false
# 範本工作表名稱（不存在時自動複製建立）
SHEET_TEMPLATE_NAME=範本
